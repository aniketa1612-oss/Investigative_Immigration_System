# Keep only the application and Git ignore configuration in the repository.
/*
!/.gitignore
!/investigative-interview-assistant/
*.md

# Local tooling and generated document previews
.codex-tmp/
.edge-render/
report_build/
conference_paper_build/

# Secrets, runtime data, and dependency caches
.env
.env.*
!.env.example
.npm-cache/
node_modules/
.venv/
__pycache__/
.pytest_cache/
dist/
*.db
*.db-shm
*.db-wal
*.log
~$*
